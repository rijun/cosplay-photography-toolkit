[Unit]
Description=Cosplay photography toolkit - celery worker

[Service]
WorkingDirectory=%h/opt/cosplay-photography-toolkit/web
ExecStart=/usr/bin/uv run --group web celery -A config worker --loglevel INFO --concurrency=2
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
